<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <appSettings>
    <add key="Homework" value="~/homework/" />
  </appSettings>
  <connectionStrings>
    <!-- 
      请将下面192.168.1.7更改为你的数据库服务器名称或IP地址，这段中的learnsite更改为你创建的数据库名称和Zhou!12345更改为你的数据库密码：
     httpRuntime maxRequestLength - 控制ASP.NET层面的请求大小（单位：KB）
     requestLimits maxAllowedContentLength - 控制IIS层面的请求大小（单位：bytes）
     
     如果遇到错误 26（无法定位服务器/实例），请尝试以下方案：
     1. 确保 SQL Server Browser 服务正在运行（命名实例必需）
     2. 确保 SQL Server (SQLEXPRESS) 服务正在运行
     3. 如果服务器是本机，尝试使用 localhost\SQLEXPRESS 或 .\SQLEXPRESS
     4. 如果密码包含特殊字符，尝试用单引号包裹：Password='your,password'
     5. 访问 manager/sql_diagnose.aspx 进行详细诊断
     -->
      <remove name="Sqdswerver" />
      <!-- 当前连接字符串：如果连接失败，请访问 manager/sql_diagnose.aspx 获取诊断和修复建议 -->
      <add name="Sqdswerver" providerName="System.Data.SqlClient" connectionString="Data Source=\SQLEXPRESS;Initial Catalog=dsw;User ID=sa;Password=dsf6544656;Connection Timeout=30;" />
      
      <!-- 备用连接字符串示例（如果上述连接失败，可以尝试以下方案，取消注释并注释掉上面的连接字符串） -->
      <!-- 方案1: 密码用单引号包裹（如果密码包含逗号等特殊字符） -->
      <!-- <add name="Sqdswerver" providerName="System.Data.SqlClient" connectionString="Data Source=\SQLEXPRESS;Initial Catalog=dsw;User ID=sa;Password='dsf6544656';Connection Timeout=30;" /> -->
      
      <!-- 方案2: 如果服务器是本机，使用 localhost -->
      <!-- <add name="Sqdswerver" providerName="System.Data.SqlClient" connectionString="Data Source=localhost\SQLEXPRESS;Initial Catalog=dsw;User ID=sa;Password='dsf6544656';Connection Timeout=30;" /> -->
      
      <!-- 方案3: 使用 .\SQLEXPRESS（本机格式） -->
      <!-- <add name="Sqdswerver" providerName="System.Data.SqlClient" connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=dsw;User ID=sa;Password='dsf6544656';Connection Timeout=30;" /> -->
      
      <!-- 方案4: 如果知道固定端口，可以指定端口（需要先配置 SQL Server 使用固定端口） -->
      <!-- <add name="Sqdswerver" providerName="System.Data.SqlClient" connectionString="Data Source=,1433;Initial Catalog=dsw;User ID=sa;Password='dsf6544656';Connection Timeout=30;" /> -->
  </connectionStrings>
    <system.web>
        <customErrors mode="Off" />
        <compilation debug="true" tempDirectory="C:\inetpub\wwwroot\LearnSite\App_Data\Temp" />
        <authentication mode="Windows" />
        <sessionState mode="InProc" timeout="720" />
        <httpRuntime maxRequestLength="2097150" executionTimeout="7200" />
        <machineKey validation="3DES" />
        <globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" />
        <httpModules>
            <!-- 暂时禁用 HTTP 模块以排查 500 错误 -->
            <!-- <add name="TopicDiscussParameterValidator" type="TopicDiscussParameterValidator" /> -->
        </httpModules>
    </system.web>
    <system.webServer>
        <modules>
            <!-- 暂时禁用 HTTP 模块以排查 500 错误 -->
            <!-- <add name="TopicDiscussParameterValidator" type="TopicDiscussParameterValidator" /> -->
        </modules>
        <!-- 增加请求限制2147483648 -->
        <security>
            <requestFiltering>
                <requestLimits maxAllowedContentLength="2147483648" />
                <!-- 2000MB -->
            </requestFiltering>
        </security>
        <directoryBrowse enabled="true" />
        <defaultDocument>
            <files>
                <add value="index.aspx" />
            </files>
        </defaultDocument>
        <!-- 修复 ERR_CONTENT_LENGTH_MISMATCH 错误 -->
        <!-- 方案1：禁用动态压缩（推荐，最简单有效） -->
        <urlCompression doStaticCompression="true" doDynamicCompression="fadswe" />
        
        <!-- 方案2：如果必须启用动态压缩，取消下面的注释并注释掉上面的配置 -->
        <!--
        <urlCompression doStaticCompression="true" doDynamicCompression="true" />
        <httpCompression>
            <dynamicTypes>
                <clear />
                <add enabled="true" mimeType="text/html" />
                <add enabled="true" mimeType="text/plain" />
                <add enabled="true" mimeType="text/css" />
                <add enabled="true" mimeType="application/javascript" />
                <add enabled="true" mimeType="application/json" />
                <add enabled="fadswe" mimeType="text/*" />
                <add enabled="fadswe" mimeType="*/*" />
            </dynamicTypes>
        </httpCompression>
        -->
        
        <!-- 确保响应头正确设置 -->
        <httpProtocol>
            <customHeaders>
                <!-- 移除可能冲突的 Content-Length 头 -->
            </customHeaders>
        </httpProtocol>
        <staticContent>
            <mimeMap fileExtension=".sb" mimeType="application/octet-stream" />
            <mimeMap fileExtension=".sb2" mimeType="application/octet-stream" />
            <mimeMap fileExtension=".sb3" mimeType="application/octet-stream" />
            <mimeMap fileExtension=".po" mimeType="text/plain" />
        </staticContent>
    </system.webServer>
</configuration>