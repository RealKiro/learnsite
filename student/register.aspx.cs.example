    /// <summary>
    /// 生成学号
    /// </summary>
    private string GenerateStudentNo()
    {
        // TODO: 根据业务规则生成学号
        // 示例：年级(2位) + 班级(2位) + 序号(3位)
        return DateTime.Now.ToString("yyyyMMddHHmmss");
    }

    /// <summary>
    /// 生成初始密码
    /// </summary>
    private string GenerateInitialPassword()
    {
        // TODO: 生成初始密码，建议使用随机密码或默认密码
        return "123456"; // 示例，实际应该更安全
