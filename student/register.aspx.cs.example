 *     Email NVARCHAR(100) NOT NULL UNIQUE,      -- 邮箱（新增）
 *     Password NVARCHAR(100) NOT NULL,          -- 密码（应加密存储）
 *     GradeId INT NOT NULL,                     -- 年级ID
