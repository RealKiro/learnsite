<%@ master language="C#" autoeventwireup="true" inherits="Student_Scm, LearnSite" %>

<script runat="server">
    protected string GetScmFaviconLinkTag()
    {
        string[] names = { "favicon.ico", "favicon.png", "favicon.svg", "images/favicon.ico", "images/favicon.png", "images/favicon.svg" };
        string[] types = { "image/x-icon", "image/png", "image/svg+xml", "image/x-icon", "image/png", "image/svg+xml" };
        for (int i = 0; i < names.Length; i++)
        {
            string fp = Server.MapPath("~/" + names[i]);
            if (System.IO.File.Exists(fp))
                return "<link rel=\"icon\" type=\"" + types[i] + "\" href=\"" + ResolveUrl("~/" + names[i]) + "?v=" + System.IO.File.GetLastWriteTime(fp).Ticks + "\" />";
        }
        return "";
    }

    protected string GetScmSiteTitle()
    {
        try
        {
            string xmlPath = Server.MapPath("~/website.xml");
            System.Xml.XmlDocument doc = new System.Xml.XmlDocument();
            doc.Load(xmlPath);
            System.Xml.XmlNode node = doc.SelectSingleNode("//add[@key='SiteTitle']");
            if (node != null && node.Attributes["value"] != null)
                return node.Attributes["value"].Value;
        }
        catch { }
        return "LearnSite";
    }

    protected string GetScmSiteLogoUrl()
    {
        string[] exts = { ".png", ".jpg", ".jpeg", ".gif", ".svg", ".webp" };
        foreach (string ext in exts)
        {
            string path = Server.MapPath("~/images/site-logo" + ext);
            if (System.IO.File.Exists(path))
                return ResolveUrl("~/images/site-logo" + ext) + "?v=" + System.IO.File.GetLastWriteTime(path).Ticks;
        }
        return "";
    }

    protected string GetScmCurrentPageName()
    {
        string p = Request.Url.AbsolutePath.ToLower();
        if (p.Contains("myinfo") || p.Contains("showcourse")) return "myinfo";
        if (p.Contains("mywork") || p.Contains("masterwork") || p.Contains("downwork")) return "mywork";
        if (p.Contains("myfinger") || p.Contains("allfinger") || p.Contains("alltyper")) return "myfinger";
        if (p.Contains("myquiz") || p.Contains("quizstart") || p.Contains("quizview")) return "myquiz";
        if (p.Contains("myfile") || p.Contains("downfile")) return "myfile";
        if (p.Contains("groupshare")) return "groupshare";
        if (p.Contains("excellentwork")) return "excellentwork";
        return "";
    }

    protected bool IsScmMyevaluatePage()
    {
        string p = Request.Url.AbsolutePath.ToLower();
        return p.EndsWith("/student/myevaluate.aspx") || p.EndsWith("myevaluate.aspx");
    }

    protected string scmUserName = "";
    protected string scmUserInitial = "\u751F";
    protected string scmUserClass = "";
    // AI对话 / 小组讨论 按钮可见性（由 CheckAndHideButtons 在 OnPreRender 中设置）
    // 默认 false：只有 DB 中明确返回启用时才显示，与 CheckAIStatus.ashx 失败关闭策略保持一致
    protected bool scmAiEnabled = false;
    protected bool scmDiscussEnabled = false;

    // ===== Dynamic Nav =====
    protected class ScmNavItem
    {
        public string Icon = "";
        public string Text = "";
        public string Url = "";
    }
    protected System.Collections.Generic.List<ScmNavItem> scmNavItems = null;

    private void LoadScmNavConfig()
    {
        try
        {
            string xmlPath = Server.MapPath("~/App_Data/navsetting.xml");
            if (!System.IO.File.Exists(xmlPath)) return;
            System.Xml.XmlDocument doc = new System.Xml.XmlDocument();
            doc.Load(xmlPath);
            System.Xml.XmlNodeList items = doc.SelectNodes("//studentNav/item");
            if (items == null || items.Count == 0) return;
            scmNavItems = new System.Collections.Generic.List<ScmNavItem>();
            foreach (System.Xml.XmlNode node in items)
            {
                ScmNavItem ni = new ScmNavItem();
                System.Xml.XmlNode iconNode = node.SelectSingleNode("icon");
                System.Xml.XmlNode textNode = node.SelectSingleNode("text");
                System.Xml.XmlNode urlNode = node.SelectSingleNode("url");
                if (iconNode != null) ni.Icon = iconNode.InnerText;
                if (textNode != null) ni.Text = textNode.InnerText;
                if (urlNode != null) ni.Url = urlNode.InnerText;
                scmNavItems.Add(ni);
            }
        }
        catch { }
    }

    protected bool ScmHasCustomNav() { return scmNavItems != null && scmNavItems.Count > 0; }

    protected string ScmRenderNavIcon(string icon)
    {
        if (string.IsNullOrEmpty(icon)) return "";
        if (icon.TrimStart().StartsWith("<")) return icon;
        return "<img src=\"" + Server.HtmlEncode(icon) + "\" />";
    }

    protected string ScmGetNavActiveClass(string url)
    {
        string currentPath = Request.Url.AbsolutePath.ToLower();
        if (string.IsNullOrEmpty(url)) return "";
        string urlLower = url.ToLower().Replace("\\", "/");
        int lastSlash = urlLower.LastIndexOf('/');
        string fileName = lastSlash >= 0 ? urlLower.Substring(lastSlash + 1) : urlLower;
        if (currentPath.EndsWith(fileName)) return "active";
        return "";
    }

    private string GetScmPropStr(object model, string propName)
    {
        if (model == null) return "";
        System.Reflection.PropertyInfo p = model.GetType().GetProperty(propName);
        if (p == null) return "";
        object v = p.GetValue(model, null);
        if (v == null) return "";
        string s = v.ToString();
        if (s.Contains("%")) { try { s = HttpUtility.UrlDecode(s, System.Text.Encoding.UTF8); } catch { } }
        return s;
    }

    private int GetScmPropInt(object model, string propName)
    {
        string s = GetScmPropStr(model, propName);
        if (string.IsNullOrEmpty(s)) return 0;
        int result;
        if (int.TryParse(s, out result)) return result;
        return 0;
    }

    private void LoadScmUserInfo()
    {
        try
        {
            HttpCookie sc = Request.Cookies[LearnSite.Common.CookieHelp.stuCookieNname];
            if (sc != null && !string.IsNullOrEmpty(sc.Value))
            {
                string cookieVal = sc.Value;
                if (cookieVal.Contains("%")) { try { cookieVal = HttpUtility.UrlDecode(cookieVal, System.Text.Encoding.UTF8); } catch { } }
                Type ct = typeof(LearnSite.Common.CookieHelp).Assembly.GetType("LearnSite.Model.Cook");
                if (ct != null)
                {
                    object m = Activator.CreateInstance(ct);
                    System.Reflection.MethodInfo mi = ct.GetMethod("ToModel",
                        System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.Static);
                    if (mi != null) mi.Invoke(m, new object[] { cookieVal });
                    string name = GetScmPropStr(m, "Sname");
                    string grade = GetScmPropStr(m, "Sgrade");
                    string cls = GetScmPropStr(m, "Sclass");
                    if (!string.IsNullOrEmpty(name))
                    {
                        scmUserName = name;
                        scmUserInitial = name.Substring(0, 1);
                    }
                    if (!string.IsNullOrEmpty(grade) && grade != "0" && !string.IsNullOrEmpty(cls) && cls != "0")
                        scmUserClass = grade + "\u5E74\u7EA7" + cls + "\u73ED";
                    else if (!string.IsNullOrEmpty(cls) && cls != "0")
                        scmUserClass = cls + "\u73ED";
                }
            }
        }
        catch { }
    }

    protected override void OnLoad(EventArgs e)
    {
        try
        {
            base.OnLoad(e);
        }
        catch (System.ArgumentNullException ex)
        {
            // 绕过 LearnSite.Common.Computer.TimePassed() 中的空日期解析异常
            // 该方法在编译的 DLL 中，对 null 字符串调用了 DateTime.Parse()
            if (ex.ParamName != "s")
                throw;
        }
        catch (System.NullReferenceException)
        {
            // 兼容已编译 DLL 中 Student_Scm.ShowListMenu() 的空引用异常
            // 发生时允许页面继续渲染，避免整页 500
        }
    }

    protected override void OnPreRender(EventArgs e)
    {
        base.OnPreRender(e);
        LoadScmUserInfo();
        LoadScmNavConfig();
        
        // 动态添加 favicon 链接，避免在 <head> 中使用代码块导致主题错误
        string faviconTag = GetScmFaviconLinkTag();
        if (!string.IsNullOrEmpty(faviconTag))
        {
            LiteralControl faviconControl = new LiteralControl(faviconTag);
            Head1.Controls.AddAt(1, faviconControl); // 在 title 之后添加
        }
        
        // 检查小组讨论和AI对话开关状态，动态隐藏按钮
        CheckAndHideButtons();
    }
    
    /// <summary>
    /// 检查Room表中的开关状态，动态隐藏对应的浮动按钮
    /// </summary>
    private void CheckAndHideButtons()
    {
        try
        {
            // 获取当前学生的年级和班级
            int grade = 0;
            int cls = 0;
            
            try
            {
                HttpCookie sc = Request.Cookies[LearnSite.Common.CookieHelp.stuCookieNname];
                if (sc != null && !string.IsNullOrEmpty(sc.Value))
                {
                    string cookieVal = sc.Value;
                    if (cookieVal.Contains("%")) { try { cookieVal = HttpUtility.UrlDecode(cookieVal, System.Text.Encoding.UTF8); } catch { } }
                    Type ct = typeof(LearnSite.Common.CookieHelp).Assembly.GetType("LearnSite.Model.Cook");
                    if (ct != null)
                    {
                        object m = Activator.CreateInstance(ct);
                        System.Reflection.MethodInfo mi = ct.GetMethod("ToModel",
                            System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.Static);
                        if (mi != null) mi.Invoke(m, new object[] { cookieVal });
                        grade = GetScmPropInt(m, "Sgrade");
                        cls = GetScmPropInt(m, "Sclass");
                    }
                }
            }
            catch { }
            
            if (grade > 0 && cls > 0)
            {
                // 查询Room表获取开关状态
                string cs = GetConnStr();
                if (!string.IsNullOrEmpty(cs))
                {
                    // 默认 false：DB 查询失败或列不存在时保持隐藏（失败关闭策略）
                    bool discussEnabled = false;
                    bool aiEnabled = false;
                    
                    using (System.Data.SqlClient.SqlConnection conn = new System.Data.SqlClient.SqlConnection(cs))
                    {
                        conn.Open();
                        
                        // 分开查询每个开关字段，避免单个字段不存在导致整个查询失败
                        try
                        {
                            using (System.Data.SqlClient.SqlCommand cmd = new System.Data.SqlClient.SqlCommand(
                                "SELECT ISNULL(Rdiscuss,1) FROM Room WHERE Rgrade=@Grade AND Rclass=@Class", conn))
                            {
                                cmd.Parameters.AddWithValue("@Grade", grade);
                                cmd.Parameters.AddWithValue("@Class", cls);
                                cmd.CommandTimeout = 5;
                                object r = cmd.ExecuteScalar();
                                if (r != null && r != DBNull.Value) discussEnabled = Convert.ToBoolean(r);
                            }
                        }
                        catch { } // Rdiscuss字段可能不存在，保持默认隐藏（失败关闭）
                        
                        try
                        {
                            using (System.Data.SqlClient.SqlCommand cmd = new System.Data.SqlClient.SqlCommand(
                                "SELECT ISNULL(Rai,1) FROM Room WHERE Rgrade=@Grade AND Rclass=@Class", conn))
                            {
                                cmd.Parameters.AddWithValue("@Grade", grade);
                                cmd.Parameters.AddWithValue("@Class", cls);
                                cmd.CommandTimeout = 5;
                                object r = cmd.ExecuteScalar();
                                if (r != null && r != DBNull.Value) aiEnabled = Convert.ToBoolean(r);
                            }
                        }
                        catch { } // Rai字段可能不存在，保持默认隐藏（失败关闭）
                    }
                    
                    // 服务端控制按钮可见性：通过 scmAiEnabled/scmDiscussEnabled 字段在渲染时直接写入 style
                    scmDiscussEnabled = discussEnabled;
                    scmAiEnabled = aiEnabled;
                }
            }
        }
        catch { }
    }
    
    /// <summary>
    /// 获取数据库连接字符串
    /// </summary>
    private string GetConnStr()
    {
        string cs = null;
        try
        {
            Type dbType = typeof(LearnSite.Common.CookieHelp).Assembly.GetType("LearnSite.DBUtility.DbHelperSQL");
            if (dbType != null)
            {
                System.Reflection.FieldInfo f = dbType.GetField("connectionString",
                    System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Static);
                if (f != null) cs = f.GetValue(null) as string;
            }
        }
        catch { }
        if (string.IsNullOrEmpty(cs))
        { try { cs = System.Configuration.ConfigurationManager.ConnectionStrings["SqlServer"].ConnectionString; } catch { } }
        if (cs != null && cs.ToLower().IndexOf("connection timeout") < 0 && cs.ToLower().IndexOf("connect timeout") < 0)
            cs = cs.TrimEnd(';') + ";Connection Timeout=5;";
        return cs;
    }

    /// <summary>
    /// 为侧边栏课程信息卡片提供数据（JSON格式）
    /// 从URL参数(cid/mcid)读取课程ID，查询课程名称、任务总数、已完成数
    /// </summary>
    protected string GetCourseCardJson()
    {
        try
        {
            string cid = Request.QueryString["cid"];
            if (string.IsNullOrEmpty(cid)) cid = Request.QueryString["mcid"];
            // 如果URL没有cid/mcid，从菜单链接中提取
            if (string.IsNullOrEmpty(cid))
            {
                try
                {
                    if (Menuact != null && Menuact.Items != null)
                    {
                        foreach (System.Web.UI.WebControls.MenuItem mi in Menuact.Items)
                        {
                            if (!string.IsNullOrEmpty(mi.NavigateUrl))
                            {
                                System.Text.RegularExpressions.Match rm = System.Text.RegularExpressions.Regex.Match(
                                    mi.NavigateUrl, "[?&]mcid=(\\d+)");
                                if (rm.Success) { cid = rm.Groups[1].Value; break; }
                                rm = System.Text.RegularExpressions.Regex.Match(
                                    mi.NavigateUrl, "[?&]cid=(\\d+)");
                                if (rm.Success) { cid = rm.Groups[1].Value; break; }
                            }
                        }
                    }
                }
                catch { }
            }
            if (string.IsNullOrEmpty(cid)) return "null";
            int courseId;
            if (!int.TryParse(cid, out courseId)) return "null";

            string cs = GetConnStr();
            if (string.IsNullOrEmpty(cs)) return "null";

            string courseName = "";
            int taskTotal = 0;
            int taskCompleted = 0;

            // 获取学生学号：优先 Session，回退到 Cookie
            string snum = "";
            if (Session["Snum"] != null) snum = Session["Snum"].ToString();
            if (string.IsNullOrEmpty(snum))
            {
                try
                {
                    HttpCookie sc = Request.Cookies[LearnSite.Common.CookieHelp.stuCookieNname];
                    if (sc != null && !string.IsNullOrEmpty(sc.Value))
                    {
                        string cv = sc.Value;
                        if (cv.Contains("%")) { try { cv = HttpUtility.UrlDecode(cv, System.Text.Encoding.UTF8); } catch { } }
                        Type ct = typeof(LearnSite.Common.CookieHelp).Assembly.GetType("LearnSite.Model.Cook");
                        if (ct != null)
                        {
                            object m = Activator.CreateInstance(ct);
                            System.Reflection.MethodInfo mi = ct.GetMethod("ToModel",
                                System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.Static);
                            if (mi != null) mi.Invoke(m, new object[] { cv });
                            snum = GetScmPropStr(m, "Snum");
                        }
                    }
                }
                catch { }
            }

            System.Data.SqlClient.SqlConnection conn = new System.Data.SqlClient.SqlConnection(cs);
            try
            {
                conn.Open();
                // 查询课程名称
                System.Data.SqlClient.SqlCommand cmd1 = new System.Data.SqlClient.SqlCommand(
                    "SELECT Ctitle FROM Courses WHERE Cid=@Cid AND (Cdelete=0 OR Cdelete IS NULL)", conn);
                try
                {
                    cmd1.Parameters.AddWithValue("@Cid", courseId);
                    cmd1.CommandTimeout = 5;
                    object r = cmd1.ExecuteScalar();
                    if (r != null && r != DBNull.Value) courseName = r.ToString();
                }
                finally { cmd1.Dispose(); }
                if (string.IsNullOrEmpty(courseName)) return "null";

                // 查询任务总数
                System.Data.SqlClient.SqlCommand cmd2 = new System.Data.SqlClient.SqlCommand(
                    "SELECT COUNT(*) FROM Listmenu WHERE Lcid=@Lcid AND (lshow IS NULL OR CONVERT(nvarchar(10),lshow) IN ('1','True','true'))", conn);
                try
                {
                    cmd2.Parameters.AddWithValue("@Lcid", courseId);
                    cmd2.CommandTimeout = 5;
                    taskTotal = Convert.ToInt32(cmd2.ExecuteScalar());
                }
                finally { cmd2.Dispose(); }

                // 查询已完成任务数
                if (!string.IsNullOrEmpty(snum))
                {
                    System.Data.SqlClient.SqlCommand cmd3 = new System.Data.SqlClient.SqlCommand(
                        "SELECT COUNT(DISTINCT L.Lid) FROM Listmenu L"
                        + " INNER JOIN Summary S ON L.Lid=S.Slid"
                        + " WHERE L.Lcid=@Lcid"
                        + " AND (L.lshow IS NULL OR CONVERT(nvarchar(10),L.lshow) IN ('1','True','true'))"
                        + " AND S.Snum=@Snum AND (S.Sshow=1 OR S.Sshow IS NULL)", conn);
                    try
                    {
                        cmd3.Parameters.AddWithValue("@Lcid", courseId);
                        cmd3.Parameters.AddWithValue("@Snum", snum);
                        cmd3.CommandTimeout = 5;
                        taskCompleted = Convert.ToInt32(cmd3.ExecuteScalar());
                    }
                    finally { cmd3.Dispose(); }
                }
            }
            finally { conn.Dispose(); }

            int pct = taskTotal > 0 ? (int)Math.Round((double)taskCompleted / taskTotal * 100.0) : 0;
            if (pct > 100) pct = 100;

            // 手动构建JSON，对课程名称做JS字符串转义
            string safeName = courseName.Replace("\\", "\\\\").Replace("\"", "\\\"").Replace("\n", " ").Replace("\r", "");
            return string.Format("{{\"name\":\"{0}\",\"completed\":{1},\"total\":{2},\"pct\":{3}}}",
                safeName, taskCompleted, taskTotal, pct);
        }
        catch
        {
            return "null";
        }
    }
</script>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml" >
<head id="Head1" runat="server">
    <title></title>
    <link href="../js/css/font-awesome.min.css" rel="stylesheet" type="text/css" />   
    <link href="../App_Themes/Student/StyleSheet.css?ver=700" rel="stylesheet" type="text/css" />
    <script src="../js/jquery-1.8.2.min.js" type="text/javascript"></script>
    <script src="../kindeditor/plugins/code/prettify.js" type="text/javascript"></script>     
    <link href="../js/tinybox.css" rel="stylesheet" type="text/css" />
    <script src="../js/tinybox.js" type="text/javascript"></script>
    <script type="text/javascript">
            // 页面加载时检查网盘状态并更新所有网盘按钮
            (function() {
                fetch('../student/CheckNetdiskStatus.ashx')
                    .then(response => response.json())
                    .then(data => {
                        if (!data.enabled) {
                            // 禁用所有网盘按钮
                            var shareButtons = document.querySelectorAll('#share, .sharedisk');
                            shareButtons.forEach(function(btn) {
                                btn.disabled = true;
                                btn.value = '网盘未开启';
                                btn.style.background = '#e5e7eb';
                                btn.style.color = '#9ca3af';
                                btn.style.cursor = 'not-allowed';
                                btn.style.opacity = '0.6';
                                btn.style.borderColor = '#d1d5db';
                            });
                        }
                    })
                    .catch(err => {
                        console.error('检查网盘状态失败:', err);
                    });
            })();
            
            function showShare() {
                // 检查网盘开关状态
                fetch('../student/CheckNetdiskStatus.ashx')
                    .then(response => response.json())
                    .then(data => {
                        if (data.enabled) {
                            var urlat = "../student/groupshare.aspx";
                            TINY.box.show({ iframe: urlat, boxid: 'frameless', width: 600, height: 400, fixed: false, maskopacity: 60, close: true });
                        } else {
                            // 禁用状态下不执行任何操作
                            return;
                        }
                    })
                    .catch(err => {
                        console.error('检查网盘状态失败:', err);
                        // 出错时默认允许访问
                        var urlat = "../student/groupshare.aspx";
                        TINY.box.show({ iframe: urlat, boxid: 'frameless', width: 600, height: 400, fixed: false, maskopacity: 60, close: true });
                    });
            }

            function showChat() {
                // 检查小组讨论开关状态
                fetch('../student/CheckDiscussStatus.ashx')
                    .then(response => response.json())
                    .then(data => {
                        if (data.enabled) {
                            var urlat = "../student/chat.aspx";
                            TINY.box.show({ iframe: urlat, boxid: 'frameless', width: 616, height: 515, fixed: false, maskopacity: 100, close: true });
                        } else {
                            // 禁用状态下不执行任何操作
                            return;
                        }
                    })
                .catch(err => {
                    console.error('检查小组讨论状态失败:', err);
                    // 出错时默认拒绝（安全策略：失败关闭）
                });
            }
            function showRobot() {
                // 检查AI对话开关状态
                fetch('../student/CheckAIStatus.ashx')
                    .then(response => response.json())
                    .then(data => {
                        if (data.enabled) {
                            var urlat = "../deepseek/robot.html";
                            TINY.box.show({ iframe: urlat, boxid: 'frameless', width: 900, height: 680, fixed: true, maskopacity: 100, close: true });
                        } else {
                            // 禁用状态下不执行任何操作
                            return;
                        }
                    })
                .catch(err => {
                    console.error('检查AI对话状态失败:', err);
                    // 出错时默认拒绝（安全策略：失败关闭）
                });
            }
    </script>
   <script src="../js/ruffle.js" type="text/javascript"></script>
	<script type="text/javascript">
		window.RufflePlayer = window.RufflePlayer || {};
		window.RufflePlayer.config = {
			"autoplay": "on",
	}
	</script>
    <style>
        /* ===== 隐藏旧 banner/canner，用新导航栏替代 ===== */
        .banner, .canner { display: none !important; }
        .menu { top: 80px !important; height: calc(100% - 80px) !important; }
        body:has(.menu) { padding-left: 180px; }
        body.scm-myevaluate-page { padding-left: 150px !important; }
        body.scm-myevaluate-page .menu {
            width: 150px !important;
            min-width: 150px !important;
            padding-left: 6px !important;
            padding-right: 6px !important;
        }
        body.scm-myevaluate-page .stu {
            overflow: visible !important;
        }
        body.scm-myevaluate-page .placeauto {
            width: auto !important;
            max-width: none !important;
            margin: 0 12px 0 158px !important;
        }
        body.scm-myevaluate-page .path {
            display: none !important;
        }

        /* ===== 侧边栏课程信息卡片（上下两行布局） ===== */
        .menu-course-card {
            margin: 0 2px 12px;
            padding: 12px 10px;
            background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
            border-radius: 10px;
            color: #fff;
            position: relative;
            overflow: hidden;
        }
        .menu-course-card::before {
            content: '' !important;
            display: block !important;
            position: absolute;
            top: -18px; right: -12px;
            width: 50px; height: 50px;
            background: rgba(255,255,255,0.1);
            border-radius: 50%;
            counter-increment: none !important;
        }
        /* Row 1: 课程名称 */
        .menu-course-name {
            font-size: 13px;
            font-weight: 700;
            line-height: 1.35;
            margin-bottom: 8px;
            position: relative;
            z-index: 1;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        /* Row 2: 进度信息行 */
        .menu-course-row2 {
            position: relative;
            z-index: 1;
        }
        .menu-course-info-line {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 11px;
            margin-bottom: 5px;
            opacity: 0.92;
        }
        .menu-course-info-line .cc-label {
            display: flex;
            align-items: center;
            gap: 3px;
        }
        .menu-course-info-line .cc-label svg {
            width: 12px; height: 12px;
            stroke: currentColor; fill: none;
            stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
        }
        .menu-course-info-line .cc-pct {
            font-weight: 700;
            font-size: 12px;
        }
        .menu-course-progress-track {
            height: 4px;
            border-radius: 999px;
            background: rgba(255,255,255,0.22);
            overflow: hidden;
        }
        .menu-course-progress-bar {
            display: block;
            height: 100%;
            border-radius: 999px;
            background: rgba(255,255,255,0.9);
            transition: width 0.3s ease;
        }

        /* ===== 新顶部导航栏样式 ===== */
        .scm-header {
            height: 80px; background: #fff;
            border-bottom: 1px solid #e8ecf1;
            display: flex !important; align-items: center;
            padding: 0 32px; flex-shrink: 0;
            box-shadow: 0 1px 4px rgba(0,0,0,.04);
            position: fixed; top: 0; left: 0; right: 0;
            z-index: 1001; width: 100%; box-sizing: border-box;
        }
        .scm-brand {
            display: flex !important; align-items: center; gap: 10px;
            flex-shrink: 0; text-decoration: none !important; margin-right: 40px !important;
        }
        .scm-brand-logo { width: 36px; height: 36px; display: flex !important; align-items: center; justify-content: center; flex-shrink: 0; }
        .scm-brand-logo img { width: 36px; height: 36px; object-fit: contain; }
        .scm-brand-name { font-size: 16px; font-weight: 700; color: #1e293b !important; white-space: nowrap; }
        .scm-nav {
            display: flex !important; align-items: center; gap: 6px;
            flex: 1; justify-content: center;
        }
        .scm-nav-item {
            display: flex !important; align-items: center; gap: 7px;
            padding: 10px 24px; border-radius: 8px;
            font-size: 14.5px; font-weight: 500; color: #64748b !important;
            text-decoration: none !important; transition: all .15s; cursor: pointer;
            white-space: nowrap; line-height: 1.2;
            background: none !important; background-color: transparent !important;
            background-image: none !important;
        }
        .scm-nav-item:hover { background-color: #f1f5f9 !important; color: #334155 !important; }
        .scm-nav-item.active { background-color: #eef2ff !important; color: #4f46e5 !important; font-weight: 600; }
        .scm-nav-item svg {
            width: 17px; height: 17px; stroke: currentColor;
            fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round;
        }
        .scm-nav-item img { width: 20px; height: 20px; object-fit: contain; vertical-align: middle; }
        .scm-header-right {
            display: flex !important; align-items: center; gap: 12px;
            flex-shrink: 0; margin-left: 40px !important;
        }
        .scm-chat-btn {
            width: 36px; height: 36px; border-radius: 8px;
            background: #f1f5f9; border: none !important;
            display: flex !important; align-items: center; justify-content: center;
            cursor: pointer; transition: all .15s; color: #64748b;
        }
        .scm-chat-btn:hover { background: #e2e8f0; color: #334155; }
        .scm-chat-btn svg {
            width: 18px; height: 18px; stroke: currentColor;
            fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round;
        }
        .scm-user-wrap { position: relative !important; display: flex !important; align-items: center; }
        .scm-user-trigger {
            display: flex !important; align-items: center; gap: 10px;
            padding: 0 14px 0 0; cursor: pointer;
            user-select: none; background: none !important; border: none !important;
        }
        .scm-avatar {
            width: 40px; height: 40px;
            background: linear-gradient(135deg, #6366f1, #a78bfa);
            border-radius: 50% !important;
            display: flex !important; align-items: center; justify-content: center;
            color: #fff !important; font-size: 16px; font-weight: 700;
            flex-shrink: 0; overflow: hidden; line-height: 40px;
        }
        .scm-user-name {
            font-size: 14px; font-weight: 600; color: #1e293b !important;
            max-width: 140px; overflow: hidden; text-overflow: ellipsis;
            white-space: nowrap; line-height: 1.2;
        }
        .scm-user-arrow {
            width: 16px; height: 16px; stroke: #94a3b8;
            fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
            transition: transform .2s; flex-shrink: 0;
        }
        .scm-user-trigger.open .scm-user-arrow { transform: rotate(180deg); }
        .scm-dropdown {
            display: none; position: absolute !important;
            top: calc(100% + 10px); right: 0; width: 220px; z-index: 9999;
        }
        .scm-dropdown.show { display: block !important; }
        .scm-dd-card {
            background: #fff; border: 1px solid #e5e7eb;
            border-radius: 10px; overflow: hidden;
        }
        .scm-dd-top { padding: 16px 18px; border-bottom: 1px solid #f3f4f6; background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%); }
        .scm-dd-top .dd-name { font-size: 15px; font-weight: 700; color: #fff; line-height: 1.3; }
        .scm-dd-top .dd-role { display: inline-block; font-size: 11px; color: #fff; margin-top: 6px; background: rgba(255,255,255,.2); padding: 3px 10px; border-radius: 12px; font-weight: 500; }
        .scm-dd-list { padding: 6px 0; }
        .scm-dd-item {
            display: flex !important; align-items: center; gap: 10px; padding: 10px 18px;
            font-size: 14px; color: #374151 !important;
            text-decoration: none !important; cursor: pointer; transition: all .15s;
        }
        .scm-dd-item:hover { background: #f9fafb; color: #111827 !important; transform: translateX(4px); }
        .scm-dd-item svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }
        .scm-dd-divider { height: 1px; background: #f3f4f6; margin: 0; }
        .scm-dd-item.logout { color: #dc2626 !important; }
        .scm-dd-item.logout:hover { background: #fef2f2; }

        /* ===== 消息通知：红点 & 弹窗 ===== */
        .scm-dd-item.notice-item { position: relative; }
        .scm-notice-dot {
            display: none;
            width: 8px; height: 8px;
            background: #ef4444;
            border-radius: 50%;
            position: absolute;
            top: 12px; right: 16px;
            animation: scmDotPulse 2s infinite;
        }
        .scm-notice-dot.show { display: block; }
        @keyframes scmDotPulse { 0%,100% { opacity:1; } 50% { opacity:.5; } }

        .scm-notice-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(15,23,42,.4); z-index: 99999;
            display: flex; align-items: center; justify-content: center;
            backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
            opacity: 0; visibility: hidden; pointer-events: none;
            transition: opacity .25s ease, visibility 0s .25s;
        }
        .scm-notice-overlay.show {
            opacity: 1; visibility: visible; pointer-events: auto;
            transition: opacity .25s ease, visibility 0s;
        }
        .scm-notice-modal {
            width: 620px; max-width: 94vw; max-height: 82vh;
            background: #fff; border-radius: 18px;
            display: flex; flex-direction: column; overflow: hidden;
            box-shadow: 0 20px 60px rgba(0,0,0,.2), 0 0 0 1px rgba(255,255,255,.1);
            transform: scale(.9) translateY(20px); opacity: 0;
            transition: transform .3s cubic-bezier(.34,1.56,.64,1), opacity .25s ease;
        }
        .scm-notice-overlay.show .scm-notice-modal {
            transform: scale(1) translateY(0); opacity: 1;
        }
        .scm-notice-modal-head {
            padding: 24px 28px 20px; flex-shrink: 0;
            background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #a855f7 100%);
            color: #fff; position: relative; overflow: hidden;
        }
        .scm-notice-modal-head::before {
            content: ''; position: absolute; top: -50px; right: -30px;
            width: 140px; height: 140px; border-radius: 50%;
            background: rgba(255,255,255,.07);
        }
        .scm-notice-modal-head::after {
            content: ''; position: absolute; bottom: -40px; left: 30px;
            width: 100px; height: 100px; border-radius: 50%;
            background: rgba(255,255,255,.05);
        }
        .scm-notice-modal-title {
            display: flex; align-items: center; justify-content: space-between;
            position: relative; z-index: 1;
        }
        .scm-notice-modal-title h3 {
            font-size: 18px; font-weight: 700; margin: 0;
            display: flex; align-items: center; gap: 10px; color: #fff;
        }
        .scm-notice-modal-title h3 svg {
            width: 22px; height: 22px; stroke: #fff; fill: none;
            stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
        }
        .scm-notice-close {
            width: 34px; height: 34px; border-radius: 50%; border: none;
            background: rgba(255,255,255,.18); cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            color: #fff; transition: all .25s;
        }
        .scm-notice-close:hover { background: rgba(255,255,255,.3); transform: rotate(90deg); }
        .scm-notice-close svg {
            width: 15px; height: 15px; stroke: currentColor; fill: none;
            stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round;
        }
        .scm-notice-modal-subtitle {
            font-size: 13px; color: rgba(255,255,255,.7); margin-top: 6px;
            position: relative; z-index: 1;
        }
        .scm-notice-modal-body {
            flex: 1; overflow-y: auto; padding: 20px 24px 24px; background: #f8f9fb;
        }
        .scm-notice-modal-body::-webkit-scrollbar { width: 5px; }
        .scm-notice-modal-body::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 3px; }
        .scm-notice-modal-body::-webkit-scrollbar-thumb:hover { background: #9ca3af; }

        .scm-notice-card {
            padding: 16px 20px; margin-bottom: 12px;
            background: #fff; border-radius: 12px;
            border-left: 3px solid #6366f1;
            box-shadow: 0 1px 4px rgba(0,0,0,.04);
            transition: all .2s ease; position: relative;
        }
        .scm-notice-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 16px rgba(99,102,241,.1);
            border-left-color: #8b5cf6;
        }
        .scm-notice-card:last-child { margin-bottom: 0; }
        .scm-notice-card-title {
            font-size: 15px; font-weight: 600; color: #1e293b;
            margin-bottom: 8px; line-height: 1.4;
        }
        .scm-notice-card-content {
            font-size: 13.5px; color: #64748b; line-height: 1.7;
            white-space: pre-wrap; word-break: break-word;
        }
        .scm-notice-card-footer {
            display: flex; align-items: center; gap: 16px;
            margin-top: 12px; font-size: 12px; color: #94a3b8;
        }
        .scm-notice-card-footer span { display: flex; align-items: center; gap: 4px; }

        .scm-notice-state { text-align: center; padding: 56px 24px 48px; }
        .scm-notice-state-icon { margin-bottom: 18px; }
        .scm-notice-state-icon svg {
            width: 52px; height: 52px; stroke-width: 1.2;
            stroke-linecap: round; stroke-linejoin: round; fill: none;
        }
        .scm-notice-state-text { font-size: 14px; color: #94a3b8; line-height: 1.6; }
        .scm-notice-state-text.error { color: #f87171; }
        .scm-notice-retry-btn {
            display: inline-flex; align-items: center; gap: 6px; margin-top: 18px;
            padding: 10px 24px; border-radius: 24px; border: none;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            font-size: 13px; font-weight: 500; color: #fff; cursor: pointer;
            transition: all .2s; font-family: inherit;
            box-shadow: 0 2px 8px rgba(99,102,241,.25);
        }
        .scm-notice-retry-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 16px rgba(99,102,241,.35);
        }
        .scm-notice-retry-btn svg {
            width: 14px; height: 14px; stroke: currentColor; fill: none;
            stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
        }
        @keyframes scmSpin { to { transform: rotate(360deg); } }
        .scm-notice-loading-spinner {
            width: 36px; height: 36px;
            border: 3px solid #e8e5ff; border-top-color: #6366f1;
            border-radius: 50%; animation: scmSpin .8s linear infinite;
            margin: 0 auto 16px;
        }
        @media (max-width: 480px) {
            .scm-notice-modal { max-width: 100vw; max-height: 100vh; border-radius: 0; }
        }

        /* 页面顶部留出导航栏高度 */
        .studmasterhead { padding-top: 80px !important; }

        @media (max-width: 1200px) {
            .scm-header { padding: 0 28px; }
            .scm-brand { margin-right: 20px !important; }
            .scm-header-right { margin-left: 20px !important; }
            .scm-nav-item { padding: 7px 14px; font-size: 13px; }
        }
        @media (max-width: 1024px) {
            .scm-brand-name { display: none; }
            .scm-brand { margin-right: 12px !important; }
            .scm-header-right { margin-left: 12px !important; }
            .scm-nav-item { padding: 6px 10px; font-size: 13px; }
            .scm-nav-item svg { display: none; }
        }
        @media (max-width: 768px) {
            .scm-header { padding: 0 12px; }
            .scm-nav-item { padding: 6px 8px; font-size: 12px; }
            .scm-user-name { display: none; }
        }
    </style>
</head>
<body class="<%= IsScmMyevaluatePage() ? "scm-myevaluate-page" : "" %>" onload="prettyPrint(); ">
    <center>
            <form id="form1" runat="server">

        <!-- ===== 新顶部导航栏 ===== -->
        <header class="scm-header">
            <a href="../student/myinfo.aspx" class="scm-brand">
                <div class="scm-brand-logo">
                    <% string sLogoUrl = GetScmSiteLogoUrl(); %>
                    <% if (!string.IsNullOrEmpty(sLogoUrl)) { %>
                        <img src="<%= sLogoUrl %>" alt="Logo" />
                    <% } else { %>
                        <svg viewBox="0 0 32 32" width="32" height="32" fill="none"><rect width="32" height="32" rx="8" fill="#6366f1"/><text x="16" y="22" text-anchor="middle" fill="#fff" font-size="16" font-weight="bold">L</text></svg>
                    <% } %>
                </div>
                <span class="scm-brand-name"><%= GetScmSiteTitle() %></span>
            </a>
            <nav class="scm-nav">
                <% if (ScmHasCustomNav()) { %>
                    <% foreach (ScmNavItem ni in scmNavItems) { %>
                    <a href="<%= ni.Url %>" class="scm-nav-item <%= ScmGetNavActiveClass(ni.Url) %>">
                        <%= ScmRenderNavIcon(ni.Icon) %>
                        <%= Server.HtmlEncode(ni.Text) %>
                    </a>
                    <% } %>
                <% } else { %>
                <a href="../student/myinfo.aspx" class="scm-nav-item <%= GetScmCurrentPageName()=="myinfo"?"active":"" %>">
                    <svg viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                    我的学案
                </a>
                <a href="../student/mywork.aspx" class="scm-nav-item <%= GetScmCurrentPageName()=="mywork"?"active":"" %>">
                    <svg viewBox="0 0 24 24"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                    我的作品
                </a>
                <a href="../student/myfinger.aspx" class="scm-nav-item <%= GetScmCurrentPageName()=="myfinger"?"active":"" %>">
                    <svg viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2" ry="2"/><path d="M7 16h10"/></svg>
                    打字宝典
                </a>
                <a href="../student/myquiz.aspx" class="scm-nav-item <%= GetScmCurrentPageName()=="myquiz"?"active":"" %>">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                    常识积累
                </a>
                <a href="../student/myfile.aspx" class="scm-nav-item <%= GetScmCurrentPageName()=="myfile"?"active":"" %>">
                    <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    在线资源
                </a>
                <a href="../student/groupshare.aspx" class="scm-nav-item <%= GetScmCurrentPageName()=="groupshare"?"active":"" %>">
                    <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                    我的网盘
                </a>
                <a href="../student/excellentwork.aspx" class="scm-nav-item <%= GetScmCurrentPageName()=="excellentwork"?"active":"" %>">
                    <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    优秀作品
                </a>
                <% } %>
            </nav>
            <div class="scm-header-right">
                <button type="button" class="scm-chat-btn" onclick="showChat()" title="小组讨论"<%if(!scmDiscussEnabled){%> style="display:none"<%}%>>
                    <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                </button>
                <div class="scm-user-wrap" id="scmUserWrap">
                    <div class="scm-user-trigger" id="scmUserTrigger" onclick="toggleScmDropdown()">
                        <div class="scm-avatar"><%= Server.HtmlEncode(scmUserInitial) %></div>
                        <span class="scm-user-name"><%= !string.IsNullOrEmpty(scmUserName) ? Server.HtmlEncode(scmUserName) : "\u5B66\u751F" %></span>
                        <svg class="scm-user-arrow" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
                    </div>
                    <div class="scm-dropdown" id="scmDropdown">
                        <div class="scm-dd-card">
                            <div class="scm-dd-top">
                                <div class="dd-name"><%= !string.IsNullOrEmpty(scmUserName) ? Server.HtmlEncode(scmUserName) : "\u5B66\u751F" %></div>
                                <div class="dd-role"><%= !string.IsNullOrEmpty(scmUserClass) ? Server.HtmlEncode(scmUserClass) : "\u5B66\u751F\u7528\u6237" %></div>
                            </div>
                            <div class="scm-dd-list">
                                <a href="javascript:void(0)" onclick="openScmNotice()" class="scm-dd-item notice-item">
                                    <svg viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                                    消息通知
                                    <span class="scm-notice-dot" id="scmNoticeDot"></span>
                                </a>
                                <a href="../profile/mygroup.aspx" class="scm-dd-item">
                                    <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                    我的小组
                                </a>
                                <a href="../profile/mypwd.aspx" class="scm-dd-item">
                                    <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                    修改密码
                                </a>
                                <a href="../profile/myphoto.aspx" class="scm-dd-item">
                                    <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                                    修改头像
                                </a>
                                <a href="javascript:void(0)" onclick="showChat()" class="scm-dd-item">
                                    <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                                    小组讨论
                                </a>
                            </div>
                            <div class="scm-dd-divider"></div>
                            <div class="scm-dd-list">
                                <a href="javascript:void(0)" onclick="doScmLogout()" class="scm-dd-item logout">
                                    <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                                    退出登录
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </header>

      <div  class="studmasterhead">
        <!-- banner/canner 已隐藏，由新导航栏替代 -->
        <div class="banner">
        </div>
		<div  class="canner" > 
        </div>
            <div  class="menu">
            <asp:Menu ID="Menuact" runat="server"   Orientation="Horizontal"  CssClass="nav">
                <StaticSelectedStyle BackColor="#EEF2FF" ForeColor="#4F46E5" />
                <StaticHoverStyle BackColor="#F4F6F9" />
            </asp:Menu>
            </div>
      <div class="stu">
        <center>
            <div class="placeauto" >
            <div  class="path"> 
            &nbsp;
            </div>
        <asp:contentplaceholder id="Cpcm" runat="server">
        </asp:contentplaceholder>
        </div>
        </center>
        <br />        
        </div>
        </div>
        </form>   
		<div class="chatimg" onclick="showChat()" title="小组在线聊天"<%if(!scmDiscussEnabled){%> style="display:none"<%}%>></div>
		<div class="robotimg" title="人工智能对话" onclick="showRobot()"<%if(!scmAiEnabled){%> style="display:none"<%}%>></div>

        <!-- 消息通知弹窗 -->
        <div class="scm-notice-overlay" id="scmNoticeOverlay" onclick="if(event.target===this)closeScmNotice()">
            <div class="scm-notice-modal">
                <div class="scm-notice-modal-head">
                    <div class="scm-notice-modal-title">
                        <h3><svg viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>消息通知</h3>
                        <button type="button" class="scm-notice-close" onclick="closeScmNotice()" title="关闭"><svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
                    </div>
                    <div class="scm-notice-modal-subtitle">查看最新的通知消息</div>
                </div>
                <div class="scm-notice-modal-body" id="scmNoticeBody">
                    <div class="scm-notice-state"><div class="scm-notice-loading-spinner"></div><div class="scm-notice-state-text">正在加载通知...</div></div>
                </div>
            </div>
        </div>

	<script type="text/javascript">window.__courseData = <%= GetCourseCardJson() %>;</script>
	<script type="text/javascript" >
	    var cbanner = "<%=Cbanner %>";
	    if (cbanner != "") {
	        var bannerurl = "url("+cbanner+")";
	        $(".banner").css({
	            "background-image": bannerurl,
	            "background-size": "cover",
	            "background-position": "right center",
	            "width": "100%"
	        });
	    }

	    // 拦截左侧菜单点击
	    // ★ 核心策略：
	    //   • showmission.aspx 链接 → 走 taskredirect.ashx 纠偏（DLL 对部分任务类型会错误分配到此页）
	    //   • 其他链接（ware.aspx / txtform.aspx / program.aspx / excel.aspx 等）
	    //     → DLL 已根据 Listmenu.Ltype 生成了正确的目标页，直接导航，仅补全缺失的 mcid
	    //   不再对所有 ?lid= 链接走 taskredirect，避免 Listmenu.Ltype 不准确导致路由到错误页面
	    $(document).ready(function() {
	        // 从当前 URL 或菜单首页链接提取课程 cid
	        function getCourseCid() {
	            var m = window.location.search.match(/[?&](?:mcid|cid)=(\d+)/);
	            if (m) return m[1];
	            var found = '';
	            $('.menu a').each(function() {
	                var h = $(this).attr('href') || '';
	                // showcourse.aspx?cid=21 格式
	                var cm = h.match(/[?&]?cid=(\d+)/);
	                if (cm) { found = cm[1]; return false; }
	            });
	            return found;
	        }
	
	        $('.menu a').click(function(e) {
	            var href = $(this).attr('href');
	            if (!href || href.indexOf('?lid=') === -1) return;
	            e.preventDefault();
	
	            // 补全 href 中缺失的 mcid（DLL 侧边栏链接通常只带 lid，不带 mcid）
	            if (href.indexOf('mcid=') === -1) {
	                var cid = getCourseCid();
	                if (cid) href = href + '&mcid=' + cid;
	            }
	
	            // showmission.aspx：DLL 有时错误地将任务分配到此页，需通过 taskredirect.ashx 重新查 DB 纠偏
	            // txtform.aspx：不走 taskredirect，由 Student_Txtform DLL 自行判断（如果是 Excel 类型任务会跳 program.aspx）
	            if (href.indexOf('showmission.aspx') > -1 ||
	                href.indexOf('mysurvey.aspx') > -1 ||
	                href.indexOf('myexam.aspx') > -1) {
	                var lidM = href.match(/[?&]lid=(\d+)/);
	                if (lidM && lidM[1]) {
	                    var midM = href.match(/[?&]mid=(\d+)/);
	                    var cidM = href.match(/[?&]mcid=(\d+)/);
	                    var rdUrl = 'taskredirect.ashx?lid=' + lidM[1];
	                    if (midM) rdUrl += '&mid=' + midM[1];
	                    if (cidM) rdUrl += '&mcid=' + cidM[1];
	                    window.location.href = rdUrl;
	                } else {
	                    window.location.href = href;
	                }
	                return;
	            }
	
	            // 其他类型（ware.aspx / txtform.aspx / program.aspx / excel.aspx
	            //           / graphshow.aspx / htmlshow.aspx / surveyshow.aspx 等）：
	            // DLL 已经根据 Ltype 生成了正确的目标页面，直接导航
	            window.location.href = href;
	        });
	    });

	    // 侧边栏注入课程信息卡片（上下两行布局）
	    (function injectCourseCard() {
	        var $menu = $('.menu');
	        if (!$menu.length) return;

	        function buildCard(d) {
	            if (!d) return;
	            var safeName = $('<span>').text(d.name || '当前课程').html();
	            var completed = d.completed || 0;
	            var total = d.total || 0;
	            var pct = d.pct || 0;
	            var cardHtml = '<div class="menu-course-card">' +
	                '<div class="menu-course-name" title="' + safeName + '">' + safeName + '</div>' +
	                '<div class="menu-course-row2">' +
	                    '<div class="menu-course-info-line">' +
	                        '<span class="cc-label"><svg viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>' + completed + '/' + total + ' 已完成</span>' +
	                        '<span class="cc-pct">' + pct + '%</span>' +
	                    '</div>' +
	                    '<div class="menu-course-progress-track"><span class="menu-course-progress-bar" style="width:' + pct + '%"></span></div>' +
	                '</div>' +
	            '</div>';
	            $menu.find('.menu-course-card').remove();
	            $menu.find('.nav').before(cardHtml);
	        }

	        // 优先使用服务端内联数据
	        if (window.__courseData) {
	            buildCard(window.__courseData);
	            return;
	        }

	        // 回退：从DOM菜单链接提取课程ID，通过AJAX获取数据
	        var cidVal = '';
	        // 先从URL提取
	        var urlMatch = window.location.search.match(/[?&](?:mcid|cid)=(\d+)/);
	        if (urlMatch) cidVal = urlMatch[1];
	        // 再从菜单链接提取
	        if (!cidVal) {
	            $menu.find('a').each(function() {
	                var href = $(this).attr('href');
	                if (href) {
	                    var m = href.match(/[?&](?:mcid|cid)=(\d+)/);
	                    if (m) { cidVal = m[1]; return false; }
	                }
	            });
	        }
	        if (!cidVal) return;

	        $.ajax({
	            url: 'getcoursecard.ashx?cid=' + cidVal,
	            dataType: 'json',
	            cache: false,
	            timeout: 5000,
	            success: function(data) { buildCard(data); }
	        });
	    })();

	    // 替换左侧菜单图标为与教师端一致的SVG图标
	    (function replaceMenuIcons() {
	        // 从当前URL提取课程ID
	        var urlParams = window.location.search;
	        var cidMatch = urlParams.match(/[?&](?:mcid|cid)=(\d+)/);
	        if (!cidMatch) return;
	        var cid = cidMatch[1];
	        
	        // 类型到SVG的映射（与教师端 courseshow.aspx replaceActivityIcons 保持一致）
	        var iconMap = {
	            '活动': '<svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>',
	            '主题': '<svg viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>',
	            '练习': '<svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>',
	            '积木': '<svg viewBox="0 0 24 24"><rect x="2" y="6" width="8" height="6" rx="1"/><rect x="14" y="6" width="8" height="6" rx="1"/><rect x="8" y="14" width="8" height="6" rx="1"/></svg>',
	            '积木编程': '<svg viewBox="0 0 24 24"><rect x="2" y="6" width="8" height="6" rx="1"/><rect x="14" y="6" width="8" height="6" rx="1"/><rect x="8" y="14" width="8" height="6" rx="1"/></svg>',
	            'Python': '<svg viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/><line x1="14" y1="4" x2="10" y2="20"/></svg>',
	            '测评': '<svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>',
	            '流程': '<svg viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>',
	            '流程图': '<svg viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>',
	            '应用': '<svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>',
	            '像素': '<svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>',
	            '拼图': '<svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>',
	            'Html': '<svg viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>',
	            '网页': '<svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>',
	            '导图': '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><line x1="12" y1="2" x2="12" y2="9"/><line x1="12" y1="15" x2="12" y2="22"/><line x1="2" y1="12" x2="9" y2="12"/><line x1="15" y1="12" x2="22" y2="12"/></svg>',
	            '脑图': '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><line x1="12" y1="2" x2="12" y2="9"/><line x1="12" y1="15" x2="12" y2="22"/><line x1="2" y1="12" x2="9" y2="12"/><line x1="15" y1="12" x2="22" y2="12"/></svg>',
	            '表格': '<svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="3" x2="9" y2="21"/></svg>',
	            '课件': '<svg viewBox="0 0 24 24"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>',
	            '讨论': '<svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>',
	            '调查': '<svg viewBox="0 0 24 24"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/></svg>',
	            '填表': '<svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="3" x2="9" y2="21"/></svg>',
	            '绘图': '<svg viewBox="0 0 24 24"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>',
	            '仓库': '<svg viewBox="0 0 24 24"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>',
	            '代码': '<svg viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>'
	        };
	        
	        // 数字编码到中文名称的映射（取默认显示名）
	        var numToName = {
	            '1':'活动','2':'主题','3':'练习','4':'积木','5':'Python',
	            '6':'测评','7':'流程图','8':'应用','9':'Html','10':'导图',
	            '11':'表格','12':'课件','13':'讨论','14':'调查','15':'填表'
	        };
	        
	        $.ajax({
	            url: 'getmenutypes.ashx?cid=' + cid,
	            dataType: 'json',
	            cache: false,
	            timeout: 5000,
	            success: function(typeMap) {
	                if (!typeMap) return;
	                // 遍历所有菜单链接
	                $('.menu a').each(function() {
	                    var href = $(this).attr('href');
	                    if (!href) return;
	                    var lidMatch = href.match(/[?&]lid=(\d+)/);
	                    if (!lidMatch) return;
	                    var lid = lidMatch[1];
	                    var ltype = typeMap[lid];
	                    if (!ltype) return;
	                    
	                    // 如果是数字编码，转换为中文名称以查找图标
	                    var typeName = ltype;
	                    if (numToName[ltype]) typeName = numToName[ltype];
	                    
	                    var svgHtml = iconMap[typeName];
	                    if (!svgHtml) return;
	                    
	                    // 在链接文本前插入图标
	                    var $link = $(this);
	                    if ($link.find('.menu-type-icon').length === 0) {
	                        $link.prepend('<span class="menu-type-icon" style="display:inline-flex;align-items:center;margin-right:6px;vertical-align:middle;">' + svgHtml + '</span>');
	                        // 设置SVG样式
	                        $link.find('.menu-type-icon svg').css({
	                            width: '16px', height: '16px',
	                            fill: 'none', stroke: 'currentColor',
	                            'stroke-width': '2', 'stroke-linecap': 'round', 'stroke-linejoin': 'round'
	                        });
	                    }
	                });
	            }
	        });
	    })();

	    // 用户下拉菜单
	    function toggleScmDropdown() {
	        document.getElementById('scmUserTrigger').classList.toggle('open');
	        document.getElementById('scmDropdown').classList.toggle('show');
	    }
	    document.addEventListener('click', function(e) {
	        var wrap = document.getElementById('scmUserWrap');
	        if (wrap && !wrap.contains(e.target)) {
	            document.getElementById('scmUserTrigger').classList.remove('open');
	            document.getElementById('scmDropdown').classList.remove('show');
	        }
	    });

        // 退出登录：直接清除 cookie 并跳转到系统首页
        function doScmLogout() {
            // 清除所有 cookie
            document.cookie.split(';').forEach(function(c) {
                var eqPos = c.indexOf('=');
                var name = eqPos > -1 ? c.substr(0, eqPos).trim() : c.trim();
                // 清除当前路径和根路径的 cookie
                document.cookie = name + '=;expires=' + new Date(0).toUTCString() + ';path=/';
                document.cookie = name + '=;expires=' + new Date(0).toUTCString() + ';path=/student';
            });
            // 跳转到系统首页
            window.location.href = '../index.aspx';
        }

        // 消息通知功能（与学生首页保持一致）
        (function(){
            var KEY = 'stu_notice_last_read_nid';
            function getLastReadNid(){ return parseInt(localStorage.getItem(KEY) || '0', 10); }
            function setLastReadNid(nid){ localStorage.setItem(KEY, nid); }

            var loadingHtml = '<div class="scm-notice-state"><div class="scm-notice-loading-spinner"></div><div class="scm-notice-state-text">正在加载通知...</div></div>';
            var emptyHtml = '<div class="scm-notice-state"><div class="scm-notice-state-icon"><svg viewBox="0 0 24 24" stroke="#c7d2fe"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg></div><div class="scm-notice-state-text">暂无通知消息</div></div>';
            var errorHtml = '<div class="scm-notice-state"><div class="scm-notice-state-icon"><svg viewBox="0 0 24 24" stroke="#fca5a5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg></div><div class="scm-notice-state-text error">加载失败，请重试</div><button type="button" class="scm-notice-retry-btn" onclick="openScmNotice()"><svg viewBox="0 0 24 24"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>重新加载</button></div>';

            function parseNotices(text){
                try {
                    if(!text) return null;
                    text = text.replace(/^\s+|\s+$/g, '');
                    return JSON.parse(text);
                } catch(e) {
                    try { var m = text.match(/\{[\s\S]*\}/); if(m) return JSON.parse(m[0]); } catch(e2){}
                    return null;
                }
            }

            function checkNotice(){
                $.ajax({
                    url: '../student/getnotices.aspx', dataType: 'text', cache: false, timeout: 10000,
                    success: function(text){
                        var data = parseNotices(text);
                        if(data && data.notices && data.notices.length > 0){
                            var maxNid = 0;
                            for(var i=0;i<data.notices.length;i++){
                                if(data.notices[i].nid > maxNid) maxNid = data.notices[i].nid;
                            }
                            if(maxNid > getLastReadNid()){
                                $('#scmNoticeDot').addClass('show');
                            } else {
                                $('#scmNoticeDot').removeClass('show');
                            }
                        }
                    }
                });
            }
            checkNotice();

            window.openScmNotice = function(){
                document.getElementById('scmUserTrigger').classList.remove('open');
                document.getElementById('scmDropdown').classList.remove('show');
                $('#scmNoticeOverlay').addClass('show');
                $('#scmNoticeBody').html(loadingHtml);
                $.ajax({
                    url: '../student/getnotices.aspx', dataType: 'text', cache: false, timeout: 15000,
                    success: function(text){
                        var data = parseNotices(text);
                        if(!data || !data.notices || data.notices.length === 0){
                            $('#scmNoticeBody').html(emptyHtml);
                            return;
                        }
                        var html = '', maxNid = 0;
                        for(var i=0;i<data.notices.length;i++){
                            var n = data.notices[i];
                            if(n.nid > maxNid) maxNid = n.nid;
                            html += '<div class="scm-notice-card">';
                            html += '<div class="scm-notice-card-title">' + escHtml(n.title) + '</div>';
                            html += '<div class="scm-notice-card-content">' + escHtml(n.content) + '</div>';
                            html += '<div class="scm-notice-card-footer"><span><svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>' + escHtml(n.author) + '</span><span><svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>' + escHtml(n.date) + '</span></div>';
                            html += '</div>';
                        }
                        $('#scmNoticeBody').html(html);
                        if(maxNid > 0){ setLastReadNid(maxNid); }
                        $('#scmNoticeDot').removeClass('show');
                    },
                    error: function(xhr){
                        if(xhr && xhr.responseText){
                            var data = parseNotices(xhr.responseText);
                            if(data && data.notices !== undefined){
                                if(data.notices.length === 0){ $('#scmNoticeBody').html(emptyHtml); }
                                else {
                                    var html = '', maxNid = 0;
                                    for(var i=0;i<data.notices.length;i++){
                                        var n = data.notices[i];
                                        if(n.nid > maxNid) maxNid = n.nid;
                                        html += '<div class="scm-notice-card">';
                                        html += '<div class="scm-notice-card-title">' + escHtml(n.title) + '</div>';
                                        html += '<div class="scm-notice-card-content">' + escHtml(n.content) + '</div>';
                                        html += '<div class="scm-notice-card-footer"><span><svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>' + escHtml(n.author) + '</span><span><svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>' + escHtml(n.date) + '</span></div>';
                                        html += '</div>';
                                    }
                                    $('#scmNoticeBody').html(html);
                                    if(maxNid > 0){ setLastReadNid(maxNid); }
                                    $('#scmNoticeDot').removeClass('show');
                                }
                                return;
                            }
                        }
                        $('#scmNoticeBody').html(errorHtml);
                    }
                });
            };

            window.closeScmNotice = function(){ $('#scmNoticeOverlay').removeClass('show'); };

            function escHtml(s){
                if(!s) return '';
                return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
            }
        })();
    </script>
   </center>
</body>
</html>
