                    </a>
                    <a href="../manager/aisetting.aspx" class="nav-item <%= GetCurrentPageName()=="aisetting"?"active":"" %>">
                        <span class="nav-icon"><svg viewBox="0 0 24 24"><path d="M12 2a4 4 0 0 1 4 4v1h1a3 3 0 0 1 3 3v1a3 3 0 0 1-3 3h-1v4a4 4 0 0 1-8 0v-4H7a3 3 0 0 1-3-3v-1a3 3 0 0 1 3-3h1V6a4 4 0 0 1 4-4z"/><circle cx="9" cy="13" r="1"/><circle cx="15" cy="13" r="1"/></svg></span>
                        <span class="nav-text">大模型设置</span>
                    </a>
                    <a href="../manager/helpsetting.aspx" class="nav-item <%= GetCurrentPageName()=="helpsetting"?"active":"" %>">
                        <span class="nav-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></span>
                        <span class="nav-text">教师端帮助中心</span>
                    </a>
                    <a href="../manager/feedback.aspx" class="nav-item <%= GetCurrentPageName()=="feedback"?"active":"" %>">
                        <span class="nav-icon"><svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span>
                        <span class="nav-text">意见反馈</span>
                    </a>
                </div>
            </div>
        </div>

        <div class="sidebar-footer">
            <asp:Label ID="LabelVer" runat="server" Font-Size="8pt" Visible="false"></asp:Label>
            <div class="sidebar-footer-text">
                版本<%= GetAppVersion() %>
            </div>
        </div>
    </div>

    <!-- ========== Main ========== -->
    <div class="main-area">
        <!-- Top Header -->
        <div class="top-header">
            <div class="header-left">
                <button type="button" class="toggle-btn" onclick="toggleSidebar()"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg></button>
            </div>
            <div class="header-right">
                <div class="header-time" id="headerTime">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px;margin-right:4px;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg><span id="clockSpan"></span>
                </div>
                <div class="user-dropdown-wrap" id="userDropdownWrap">
                    <div class="user-trigger" id="userTrigger" onclick="toggleUserDropdown()">
                        <% if (!string.IsNullOrEmpty(mUserAvatarUrl)) { %>
                        <div class="user-avatar"><img src="<%= mUserAvatarUrl %>" /></div>
                        <% } else { %>
                        <div class="user-avatar"><%= Server.HtmlEncode(mUserInitial) %></div>
                        <% } %>
                        <span class="user-trigger-name"><%= !string.IsNullOrEmpty(mUserName) ? Server.HtmlEncode(mUserName) : "\u7BA1\u7406\u5458" %></span>
                        <svg class="user-trigger-arrow" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
                    </div>
                    <div class="user-dropdown" id="userDropdown">
                        <div class="dd-profile">
                            <% if (!string.IsNullOrEmpty(mUserAvatarUrl)) { %>
                            <div class="dd-profile-avatar"><img src="<%= mUserAvatarUrl %>" /></div>
                            <% } else { %>
                            <div class="dd-profile-avatar"><%= Server.HtmlEncode(mUserInitial) %></div>
                            <% } %>
                            <div class="dd-profile-info">
                                <div class="dd-profile-name"><%= !string.IsNullOrEmpty(mUserName) ? Server.HtmlEncode(mUserName) : "\u7BA1\u7406\u5458" %></div>
                                <div class="dd-profile-role">管理员</div>
                            </div>
                        </div>
                        <div class="dd-menu">
                            <a href="../manager/profile.aspx" class="dd-menu-item">
                                <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                个人中心
                            </a>
                            <a href="../manager/setting.aspx" class="dd-menu-item">
                                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                                系统设置
                            </a>
                            <div class="dd-sep"></div>
                            <a href="javascript:void(0);" class="dd-menu-item dd-logout" onclick="return openLogoutModal(event);">
                                <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                                退出系统
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Content -->
        <div class="content-area">
            <asp:ContentPlaceHolder ID="Content" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </div>
    </div><!-- /layout-wrapper -->

    <asp:Button ID="BtnMasterLogout" runat="server" CssClass="master-hidden-action" OnClick="BtnMasterLogout_Click" UseSubmitBehavior="false" />

    <div class="logout-modal" id="logoutModal" onclick="handleLogoutModalMask(event)">
        <div class="logout-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="logoutModalTitle">
            <div class="logout-modal-head">
                <div class="logout-modal-icon">
                    <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                </div>
                <div>
                    <div class="logout-modal-title" id="logoutModalTitle">确认退出登录？</div>
                    <div class="logout-modal-subtitle">退出后将返回管理后台登录页</div>
                </div>
            </div>
            <div class="logout-modal-body">
                当前登录身份将被安全退出。如需继续访问后台，需要重新登录。
            </div>
            <div class="logout-modal-actions">
                <button type="button" class="logout-modal-btn cancel" onclick="closeLogoutModal()">取消</button>
                <button type="button" class="logout-modal-btn confirm" onclick="submitLogout()">确认退出</button>
            </div>
        </div>
    </div>

    <script type="text/javascript">
        // Nav group collapse
        function toggleNavGroup(groupId) {
            var sidebar = document.getElementById('sidebarEl');
            if (sidebar && sidebar.classList.contains('collapsed')) return;
            var group = document.getElementById(groupId);
            if (!group) return;
            group.classList.toggle('collapsed');
            try {
                var states = JSON.parse(localStorage.getItem('navGroupStates') || '{}');
                states[groupId] = group.classList.contains('collapsed') ? '1' : '0';
                localStorage.setItem('navGroupStates', JSON.stringify(states));
            } catch(e) {}
        }
        // Restore nav group states on load
        (function() {
            try {
                var states = JSON.parse(localStorage.getItem('navGroupStates') || '{}');
                ['group-system','group-student','group-data','group-personal','group-website'].forEach(function(id) {
                    if (states[id] === '1') {
                        var el = document.getElementById(id);
                        if (el) el.classList.add('collapsed');
                    }
                });
                // Auto-expand the group that contains the active menu item
                document.querySelectorAll('.nav-group.collapsed').forEach(function(group) {
                    if (group.querySelector('.nav-item.active')) {
                        group.classList.remove('collapsed');
                        try {
                            var s = JSON.parse(localStorage.getItem('navGroupStates') || '{}');
                            s[group.id] = '0';
                            localStorage.setItem('navGroupStates', JSON.stringify(s));
                        } catch(e) {}
                    }
                });
            } catch(e) {}
        })();

        // Sidebar toggle
        function toggleSidebar() {
            var sb = document.getElementById('sidebarEl');
            sb.classList.toggle('collapsed');
            try { localStorage.setItem('sidebarCollapsed', sb.classList.contains('collapsed') ? '1' : '0'); } catch(e){}
        }
        // Restore sidebar state
        (function(){
            try {
                if (localStorage.getItem('sidebarCollapsed') === '1') {
                    document.getElementById('sidebarEl').classList.add('collapsed');
                }
            } catch(e){}
        })();

        // Legacy compat
        function ShowMenu() { 
            var sb = document.getElementById('sidebarEl');
            if (sb) sb.classList.remove('collapsed');
        }
        function HideMenu() { 
            var sb = document.getElementById('sidebarEl');
            if (sb) sb.classList.add('collapsed');
        }

        // Clock
        function updateClock() {
            var now = new Date();
            var h = now.getHours().toString().padStart(2,'0');
            var m = now.getMinutes().toString().padStart(2,'0');
            var d = (now.getMonth()+1) + '月' + now.getDate() + '日';
            var el = document.getElementById('clockSpan');
            if (el) el.textContent = d + ' ' + h + ':' + m;
        }
        updateClock();
        setInterval(updateClock, 30000);

        // User dropdown
        function toggleUserDropdown() {
            var trigger = document.getElementById('userTrigger');
            var dropdown = document.getElementById('userDropdown');
            trigger.classList.toggle('open');
            dropdown.classList.toggle('show');
        }
        // Close dropdown on outside click
        document.addEventListener('click', function(e) {
            var wrap = document.getElementById('userDropdownWrap');
            if (wrap && !wrap.contains(e.target)) {
                document.getElementById('userTrigger').classList.remove('open');
                document.getElementById('userDropdown').classList.remove('show');
            }
        });

        function openLogoutModal(e) {
            if (e) {
                if (e.preventDefault) e.preventDefault();
                if (e.stopPropagation) e.stopPropagation();
            }
            var trigger = document.getElementById('userTrigger');
            var dropdown = document.getElementById('userDropdown');
            var modal = document.getElementById('logoutModal');
            if (trigger) trigger.classList.remove('open');
            if (dropdown) dropdown.classList.remove('show');
            if (modal) modal.classList.add('show');
            return false;
        }

        function closeLogoutModal() {
            var modal = document.getElementById('logoutModal');
            if (modal) modal.classList.remove('show');
        }

        function handleLogoutModalMask(e) {
            if (e && e.target && e.target.id === 'logoutModal') {
                closeLogoutModal();
            }
        }

        function submitLogout() {
            var btn = document.getElementById('<%= BtnMasterLogout.ClientID %>');
            if (btn) btn.click();
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeLogoutModal();
            }
        });

        // ===== 后台更新自动检测 =====
        (function(){
            var INTERVAL = 4 * 60 * 60 * 1000; // 4 小时检测一次
            var LS_KEY   = 'ls_upd_notify_v1';
            var curPage  = (window.location.pathname || '').toLowerCase();
            var updateUrl = '<%= ResolveUrl("~/manager/systemupdate.aspx?autoupdate=1") %>';
            var isIndexPage = /\/manager\/(?:index\.aspx)?$/i.test(curPage);
            var currentVersion = '<%= GetAppVersion() %>';

            function normalizeVer(ver) {
                return (ver || '').toString().replace(/^[vV]/, '');
            }

            function compareVer(a, b) {
                var p1 = normalizeVer(a).split('.');
                var p2 = normalizeVer(b).split('.');
                var len = Math.max(p1.length, p2.length);
                for (var i = 0; i < len; i++) {
                    var x = parseInt(p1[i] || '0', 10);
                    var y = parseInt(p2[i] || '0', 10);
                    if (isNaN(x)) x = 0;
                    if (isNaN(y)) y = 0;
                    if (x > y) return 1;
                    if (x < y) return -1;
                }
                return 0;
            }

            function clearToastCache() {
                try { localStorage.removeItem(LS_KEY); } catch(e) {}
            }

            function showToast(ver) {
                if (compareVer(currentVersion, ver) >= 0) {
                    clearToastCache();
                    return;
                }
                var el = document.getElementById('updateToast');
                if (!el) return;
                var vEl = document.getElementById('utVer');
                if (vEl) vEl.textContent = ver;
                el.classList.toggle('home-toast', isIndexPage);
                el.classList.add('ut-clickable');
                el.onclick = function() { window.location.href = updateUrl; };
                setTimeout(function(){ el.classList.add('show'); }, 1000);
                // 35 秒后自动消失
                setTimeout(function(){ el.classList.remove('show'); }, 36000);
            }

            window.__utClose = function() {
                var el = document.getElementById('updateToast');
                if (el) el.classList.remove('show');
                // 点击「稍后再说」后本次运行内不再弹出
                try {
                    var d = JSON.parse(localStorage.getItem(LS_KEY) || 'null');
                    if (d) { d.dismissed = true; localStorage.setItem(LS_KEY, JSON.stringify(d)); }
                } catch(e) {}
            };

            function runCheck() {
                var xhr = new XMLHttpRequest();
                xhr.open('GET', '<%= ResolveUrl("~/manager/checkupdate.ashx") %>?_=' + Date.now(), true);
                xhr.timeout = 12000;
                xhr.onload = function() {
                    if (xhr.status === 200) {
                        try {
                            var r = JSON.parse(xhr.responseText);
                            if (r && r.success) {
                                try {
                                    localStorage.setItem(LS_KEY, JSON.stringify({
                                        t: Date.now(), has: r.hasUpdate,
                                        ver: r.latestVersion, dismissed: false
                                    }));
                                } catch(e) {}
                                if (r.hasUpdate) showToast(r.latestVersion);
                            }
                        } catch(e) {}
                    }
                };
                xhr.onerror = xhr.ontimeout = function(){};
                xhr.send();
            }

            // 页面加载 2.5s 后执行，不阻塞首屏渲染
            setTimeout(function() {
                try {
                    var d = JSON.parse(localStorage.getItem(LS_KEY) || 'null');
                    if (d && d.ver && compareVer(currentVersion, d.ver) >= 0) {
                        clearToastCache();
                        d = null;
                    }
                    // systemupdate 页面自带检测功能，跳过toast
                    if (curPage.indexOf('systemupdate') !== -1) return;
                    if (d && (Date.now() - d.t) < INTERVAL) {
                        if (d.has && !d.dismissed) showToast(d.ver);
                        return;
                    }
                } catch(e) {}

                runCheck();
            }, 2500);
        }());
    </script>

    <!-- 更新通知Toast -->
    <div id="updateToast">
        <div class="ut-bar"></div>
        <div class="ut-body">
            <div class="ut-icon">
                <svg viewBox="0 0 24 24"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
            </div>
            <div class="ut-info">
                <div class="ut-title">发现系统新版本&nbsp;<span id="utVer"></span></div>
                <div class="ut-desc">建议尽快更新以获取新功能和安全修复</div>
            </div>
            <div class="ut-close" onclick="event.stopPropagation();__utClose()">
                <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </div>
        </div>
        <div class="ut-footer">
            <a href="<%= ResolveUrl("~/manager/systemupdate.aspx?autoupdate=1") %>" class="ut-go" onclick="event.stopPropagation()">立即前往更新</a>
            <button class="ut-later" onclick="event.stopPropagation();__utClose()">稍后再说</button>
        </div>
    </div>

    </form>
</body>
</html>
