            <div class="nav-group-label">游戏管理</div>
            <a href="../teacher/gamemanage.aspx" class="nav-item <%= GetCurrentPageName()=="gamemanage"?"active":"" %>">
                <span class="nav-icon"><svg viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="15" rx="2" ry="2"/><polyline points="17 2 12 7 7 2"/></svg></span>
                <span class="nav-text">游戏管理</span>
            </a>
            <a href="../teacher/gameupdate.aspx" class="nav-item <%= GetCurrentPageName()=="gameupdate"?"active":"" %>">
                <span class="nav-icon"><svg viewBox="0 0 24 24"><polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/></svg></span>
                <span class="nav-text">更新游戏</span>
            </a>

            <div class="nav-group-label">系统</div>
            <a href="<%= GetProfileUrl() %>" class="nav-item <%= GetCurrentPageName()=="profile"?"active":"" %>">
                <span class="nav-icon"><svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></span>
                <span class="nav-text">个人中心</span>
            </a>
            <a href="../teacher/systeminfo.aspx" class="nav-item <%= GetCurrentPageName()=="systeminfo"?"active":"" %>">
                <span class="nav-icon"><svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg></span>
                <span class="nav-text">系统状态</span>
            </a>
            <a href="../teacher/helper.aspx" class="nav-item <%= GetCurrentPageName()=="helper"?"active":"" %>">
                <span class="nav-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></span>
                <span class="nav-text">帮助</span>
            </a>
        </div>

        <div class="sidebar-footer">
            <button type="button" class="sb-collapse-btn" onclick="toggleSidebar()" title="折叠/展开菜单">
                <svg class="sb-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                <span class="sb-collapse-text">折叠菜单</span>
            </button>
            <div class="sidebar-footer-text">
                版本<%= GetAppVersion() %>
            </div>
        </div>
    </div>

    <!-- ========== Main ========== -->
    <div class="main-area">
        <!-- Top Header -->
        <div class="top-header">
            <div class="header-left">
                <button type="button" class="toggle-btn" onclick="toggleSidebar()"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg></button>
            </div>
            <div class="header-right">
                <div class="header-time" id="headerTime">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px;margin-right:4px;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg><span id="clockSpan"></span>
                </div>
                <div class="user-dropdown-wrap" id="userDropdownWrap">
                    <div class="user-trigger" id="userTrigger" onclick="toggleUserDropdown(event)">
                        <% if (!string.IsNullOrEmpty(tUserAvatarUrl)) { %>
                        <div class="user-avatar"><img src="<%= tUserAvatarUrl %>" /></div>
                        <% } else { %>
                        <div class="user-avatar"><%= Server.HtmlEncode(tUserInitial) %></div>
                        <% } %>
                        <span class="user-trigger-name"><%= !string.IsNullOrEmpty(tUserName) ? Server.HtmlEncode(tUserName) : "\u6559\u5E08" %></span>
                        <svg class="user-trigger-arrow" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
                    </div>
                    <div class="user-dropdown" id="userDropdown">
                        <div class="dd-profile">
                            <% if (!string.IsNullOrEmpty(tUserAvatarUrl)) { %>
                            <div class="dd-profile-avatar"><img src="<%= tUserAvatarUrl %>" /></div>
                            <% } else { %>
                            <div class="dd-profile-avatar"><%= Server.HtmlEncode(tUserInitial) %></div>
                            <% } %>
                            <div class="dd-profile-info">
                                <div class="dd-profile-name"><%= !string.IsNullOrEmpty(tUserName) ? Server.HtmlEncode(tUserName) : "\u6559\u5E08" %></div>
                                <div class="dd-profile-role">教师</div>
                            </div>
                        </div>
                        <div class="dd-menu">
                            <a href="<%= GetProfileUrl() %>" class="dd-menu-item">
                                <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                个人中心
                            </a>
                            <a href="<%= ResolveUrl("~/teacher/helper.aspx") %>" class="dd-menu-item">
                                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                                帮助
                            </a>
                            <div class="dd-sep"></div>
                            <a href="javascript:void(0)" class="dd-menu-item dd-logout" onclick="doLogout(); return false;">
                                <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                                退出系统
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Content -->
        <div class="content-area">
            <asp:ContentPlaceHolder id="Content" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </div>
    </div><!-- /layout-wrapper -->

    <div class="ls-logout-modal" id="logoutModal" onclick="handleLogoutModalBackdrop(event)">
        <div class="ls-logout-dialog" role="dialog" aria-modal="true" aria-labelledby="logoutModalTitle">
            <div class="ls-logout-head">
                <div class="ls-logout-icon">
                    <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                </div>
                <div class="ls-logout-headtext">
                    <div class="ls-logout-title" id="logoutModalTitle">确认退出登录</div>
                    <div class="ls-logout-subtitle">退出后需要重新输入账号密码</div>
                </div>
            </div>
            <div class="ls-logout-body">
                <div class="ls-logout-text">确定要退出当前账号吗？退出后将离开教师工作台，重新登录后才能继续使用当前功能。</div>
                <div class="ls-logout-actions">
                    <button type="button" class="ls-logout-btn" id="logoutCancelBtn" onclick="closeLogoutConfirm()">取消</button>
                    <button type="button" class="ls-logout-btn ls-logout-btn-primary" id="logoutConfirmBtn" onclick="executeLogout()">确认退出</button>
                </div>
            </div>
        </div>
    </div>

    <script type="text/javascript">
        // Sidebar toggle
        function toggleSidebar() {
            var sb = document.getElementById('sidebarEl');
            sb.classList.toggle('collapsed');
            try { localStorage.setItem('teachSidebarCollapsed', sb.classList.contains('collapsed') ? '1' : '0'); } catch(e){}
        }
        (function(){
            try {
                if (localStorage.getItem('teachSidebarCollapsed') === '1') {
                    document.getElementById('sidebarEl').classList.add('collapsed');
                }
            } catch(e){}
        })();

        // Legacy compat
        function ShowMenu() {
            var sb = document.getElementById('sidebarEl');
            if (sb) sb.classList.remove('collapsed');
        }
        function HideMenu() {
            var sb = document.getElementById('sidebarEl');
            if (sb) sb.classList.add('collapsed');
        }

        // Clock
        function updateClock() {
            var now = new Date();
            var h = now.getHours().toString().padStart(2,'0');
            var m = now.getMinutes().toString().padStart(2,'0');
            var d = (now.getMonth()+1) + '月' + now.getDate() + '日';
            var el = document.getElementById('clockSpan');
            if (el) el.textContent = d + ' ' + h + ':' + m;
        }
        updateClock();
        setInterval(updateClock, 30000);

        // User dropdown
        function toggleUserDropdown(event) {
            if (event) {
                event.stopPropagation();
            }
            var trigger = document.getElementById('userTrigger');
            var dropdown = document.getElementById('userDropdown');
            if (trigger && dropdown) {
                trigger.classList.toggle('open');
                dropdown.classList.toggle('show');
            }
        }

        function closeUserDropdown() {
            var trigger = document.getElementById('userTrigger');
            var dropdown = document.getElementById('userDropdown');
            if (trigger) trigger.classList.remove('open');
            if (dropdown) dropdown.classList.remove('show');
        }

        function openLogoutConfirm() {
            var modal = document.getElementById('logoutModal');
            closeUserDropdown();
            if (modal) {
                modal.classList.add('show');
            }
            setTimeout(function () {
                var btn = document.getElementById('logoutConfirmBtn');
                if (btn) {
                    try { btn.focus(); } catch (e) { }
                }
            }, 40);
            return false;
        }

        function closeLogoutConfirm() {
            var modal = document.getElementById('logoutModal');
            if (modal) {
                modal.classList.remove('show');
            }
            return false;
        }

        function handleLogoutModalBackdrop(event) {
            if (event && event.target && event.target.id === 'logoutModal') {
                closeLogoutConfirm();
            }
        }

        // Logout: try clicking the hidden server button on infomation page, otherwise navigate
        function executeLogout() {
            closeLogoutConfirm();
            var btn = document.getElementById('<%= "Content_Btnlogout" %>');
            if (!btn) {
                // Try alternate ID patterns generated by ASP.NET
                var all = document.querySelectorAll('input[type="submit"][id*="Btnlogout"]');
                if (all.length > 0) btn = all[0];
            }
            if (btn) {
                btn.click();
            } else {
                // Not on infomation page, navigate there with auto-logout param
                window.location.href = '<%= ResolveUrl("~/teacher/infomation.aspx") %>?logout=1';
            }
            return false;
        }

        function doLogout() {
            return openLogoutConfirm();
        }
        
        // Close dropdown when clicking outside
        document.addEventListener('click', function(e) {
            var wrap = document.getElementById('userDropdownWrap');
            if (wrap && !wrap.contains(e.target)) {
                closeUserDropdown();
            }
        });
        document.addEventListener('keydown', function(e) {
            var modal = document.getElementById('logoutModal');
            if (!modal || modal.className.indexOf('show') < 0) {
                return;
            }
            if (e.keyCode === 27) {
                closeLogoutConfirm();
            }
        });
        // Nav group collapsible
        (function() {
            var NG_KEY = 'teachNavGroupsCollapsed';
            function ngGet() { try { return JSON.parse(localStorage.getItem(NG_KEY)) || {}; } catch(e) { return {}; } }
            function ngSet(s) { try { localStorage.setItem(NG_KEY, JSON.stringify(s)); } catch(e) {} }
            function initNavGroups() {
                var sidebar = document.getElementById('sidebarEl');
                if (!sidebar) return;
                var navDiv = sidebar.querySelector('.sidebar-nav');
                if (!navDiv) return;
                var children = [];
                for (var k = 0; k < navDiv.children.length; k++) children.push(navDiv.children[k]);
                var groups = [], cur = null, items = [];
                for (var i = 0; i < children.length; i++) {
                    var c = children[i];
                    if (c.classList && c.classList.contains('nav-group-label')) {
                        if (cur) groups.push({lbl: cur, items: items.slice()});
                        cur = c; items = [];
                    } else if (c.classList && c.classList.contains('nav-item') && cur) {
                        items.push(c);
                    }
                }
                if (cur) groups.push({lbl: cur, items: items.slice()});
                var state = ngGet();
                groups.forEach(function(g, idx) {
                    var gid = 'ng' + idx;
                    // Build group wrapper
                    var wrap = document.createElement('div');
                    wrap.className = 'nav-group';
                    wrap.setAttribute('data-gid', gid);
                    // Add chevron arrow to label
                    var arrow = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
                    arrow.setAttribute('class', 'nav-group-arrow');
                    arrow.setAttribute('viewBox', '0 0 24 24');
                    arrow.setAttribute('fill', 'none');
                    arrow.setAttribute('stroke', 'currentColor');
                    arrow.setAttribute('stroke-width', '2');
                    arrow.setAttribute('stroke-linecap', 'round');
                    arrow.setAttribute('stroke-linejoin', 'round');
                    var pl = document.createElementNS('http://www.w3.org/2000/svg', 'polyline');
                    pl.setAttribute('points', '6 9 12 15 18 9');
                    arrow.appendChild(pl);
                    g.lbl.appendChild(arrow);
                    g.lbl.setAttribute('data-gid', gid);
                    g.lbl.onclick = function() { window.toggleNavGroup(this.getAttribute('data-gid')); };
                    // Build items container
                    var itemsDiv = document.createElement('div');
                    itemsDiv.className = 'nav-group-items';
                    g.items.forEach(function(it) { itemsDiv.appendChild(it); });
                    // Re-insert wrapped structure
                    navDiv.insertBefore(wrap, g.lbl);
                    wrap.appendChild(g.lbl);
                    wrap.appendChild(itemsDiv);
                    // Restore saved state
                    if (state[gid]) wrap.classList.add('collapsed');
                });
                // Auto-expand the group that contains the active nav item
                var active = navDiv.querySelector('.nav-item.active');
                if (active) {
                    var pg = active.parentElement;
                    if (pg && pg.classList.contains('nav-group-items')) {
                        var gw = pg.parentElement;
                        if (gw && gw.classList.contains('collapsed')) {
                            gw.classList.remove('collapsed');
                            var s = ngGet(); delete s[gw.getAttribute('data-gid')]; ngSet(s);
                        }
                    }
                }
            }
            window.toggleNavGroup = function(gid) {
                var sb = document.getElementById('sidebarEl');
                if (sb && sb.classList.contains('collapsed')) return; // icon mode: no toggling
                var wrap = document.querySelector('.nav-group[data-gid="' + gid + '"]');
                if (!wrap) return;
                var now = wrap.classList.toggle('collapsed');
                var s = ngGet();
                if (now) s[gid] = 1; else delete s[gid];
                ngSet(s);
            };
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initNavGroups);
            } else {
                initNavGroups();
            }
        })();
    </script>

    </form>
</body>
</html>
