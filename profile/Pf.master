    </div><!-- /pf-wrap -->

    <!-- 消息通知弹窗 -->
    <div class="pf-notice-overlay" id="pfNoticeOverlay" onclick="if(event.target===this)closePfNotice()">
        <div class="pf-notice-modal">
            <div class="pf-notice-modal-head">
                <div class="pf-notice-modal-title">
                    <h3><svg viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>消息通知</h3>
                    <button type="button" class="pf-notice-close" onclick="closePfNotice()" title="关闭"><svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
                </div>
                <div class="pf-notice-modal-subtitle">查看最新的通知消息</div>
            </div>
            <div class="pf-notice-modal-body" id="pfNoticeBody">
                <div class="pf-notice-state"><div class="pf-notice-loading-spinner"></div><div class="pf-notice-state-text">正在加载通知...</div></div>
            </div>
        </div>
    </div>

    </form>

    <script type="text/javascript">
        function togglePfDropdown() {
            document.getElementById('pfUserTrigger').classList.toggle('open');
            document.getElementById('pfDropdown').classList.toggle('show');
        }
        document.addEventListener('click', function(e) {
            var wrap = document.getElementById('pfUserWrap');
            if (wrap && !wrap.contains(e.target)) {
                document.getElementById('pfUserTrigger').classList.remove('open');
                document.getElementById('pfDropdown').classList.remove('show');
            }
        });
        function doPfLogout() {
            window.location.href = '../student/myinfo.aspx?logout=1';
        }
        (function(){
            var cur = '<%= PfCurrentPage() %>';
            if (!cur) return;
            var links = document.querySelectorAll('.pf-sidenav a');
            links.forEach(function(a){
                if (a.getAttribute('data-page') === cur) a.classList.add('pf-active');
            });
        })();
    </script>
    <script src="../js/pub-footer.js"></script>
    <script type="text/javascript">
        // 消息通知功能
        (function(){
            var KEY = 'stu_notice_last_read_nid';
            function getLastReadNid(){ return parseInt(localStorage.getItem(KEY) || '0', 10); }
            function setLastReadNid(nid){ localStorage.setItem(KEY, nid); }

            var loadingHtml = '<div class="pf-notice-state"><div class="pf-notice-loading-spinner"></div><div class="pf-notice-state-text">正在加载通知...</div></div>';
            var emptyHtml = '<div class="pf-notice-state"><div class="pf-notice-state-icon"><svg viewBox="0 0 24 24" stroke="#c7d2fe"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg></div><div class="pf-notice-state-text">暂无通知消息</div></div>';
            var errorHtml = '<div class="pf-notice-state"><div class="pf-notice-state-icon"><svg viewBox="0 0 24 24" stroke="#fca5a5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg></div><div class="pf-notice-state-text error">加载失败，请重试</div><button type="button" class="pf-notice-retry-btn" onclick="openPfNotice()"><svg viewBox="0 0 24 24"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>重新加载</button></div>';

            function parseNotices(text){
                try {
                    if(!text) return null;
                    text = text.replace(/^\s+|\s+$/g, '');
                    return JSON.parse(text);
                } catch(e) {
                    try { var m = text.match(/\{[\s\S]*\}/); if(m) return JSON.parse(m[0]); } catch(e2){}
                    return null;
                }
            }

            function checkNotice(){
                $.ajax({
                    url: '../student/getnotices.aspx', dataType: 'text', cache: false, timeout: 10000,
                    success: function(text){
                        var data = parseNotices(text);
                        if(data && data.notices && data.notices.length > 0){
                            var maxNid = 0;
                            for(var i=0;i<data.notices.length;i++){
                                if(data.notices[i].nid > maxNid) maxNid = data.notices[i].nid;
                            }
                            if(maxNid > getLastReadNid()){
                                $('#pfNoticeDot').addClass('show');
                            } else {
                                $('#pfNoticeDot').removeClass('show');
                            }
                        }
                    }
                });
            }
            checkNotice();

            window.openPfNotice = function(){
                document.getElementById('pfUserTrigger').classList.remove('open');
                document.getElementById('pfDropdown').classList.remove('show');
                $('#pfNoticeOverlay').addClass('show');
                $('#pfNoticeBody').html(loadingHtml);
                $.ajax({
                    url: '../student/getnotices.aspx', dataType: 'text', cache: false, timeout: 15000,
                    success: function(text){
                        var data = parseNotices(text);
                        if(!data || !data.notices || data.notices.length === 0){
                            $('#pfNoticeBody').html(emptyHtml);
                            return;
                        }
                        var html = '', maxNid = 0;
                        for(var i=0;i<data.notices.length;i++){
                            var n = data.notices[i];
                            if(n.nid > maxNid) maxNid = n.nid;
                            html += '<div class="pf-notice-card">';
                            html += '<div class="pf-notice-card-title">' + escHtml(n.title) + '</div>';
                            html += '<div class="pf-notice-card-content">' + escHtml(n.content) + '</div>';
                            html += '<div class="pf-notice-card-footer"><span><svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>' + escHtml(n.author) + '</span><span><svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>' + escHtml(n.date) + '</span></div>';
                            html += '</div>';
                        }
                        $('#pfNoticeBody').html(html);
                        if(maxNid > 0){ setLastReadNid(maxNid); }
                        $('#pfNoticeDot').removeClass('show');
                    },
                    error: function(xhr){
                        // 尝试从错误响应中解析JSON
                        if(xhr && xhr.responseText){
                            var data = parseNotices(xhr.responseText);
                            if(data && data.notices !== undefined){
                                if(data.notices.length === 0){ $('#pfNoticeBody').html(emptyHtml); }
                                else {
                                    var html = '', maxNid = 0;
                                    for(var i=0;i<data.notices.length;i++){
                                        var n = data.notices[i];
                                        if(n.nid > maxNid) maxNid = n.nid;
                                        html += '<div class="pf-notice-card">';
                                        html += '<div class="pf-notice-card-title">' + escHtml(n.title) + '</div>';
                                        html += '<div class="pf-notice-card-content">' + escHtml(n.content) + '</div>';
                                        html += '<div class="pf-notice-card-footer"><span><svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>' + escHtml(n.author) + '</span><span><svg viewBox="0 0 24 24" style="width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>' + escHtml(n.date) + '</span></div>';
                                        html += '</div>';
                                    }
                                    $('#pfNoticeBody').html(html);
                                    if(maxNid > 0){ setLastReadNid(maxNid); }
                                    $('#pfNoticeDot').removeClass('show');
                                }
                                return;
                            }
                        }
                        $('#pfNoticeBody').html(errorHtml);
                    }
                });
            };

            window.closePfNotice = function(){ $('#pfNoticeOverlay').removeClass('show'); };

            function escHtml(s){
                if(!s) return '';
                return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
            }
        })();
    </script>
</body>
</html>
