<?xml version="1.0" encoding="utf-8"?>
<!--
  LearnSite 邮件配置文件
  用于配置邮箱验证码发送功能的SMTP服务器信息

  配置说明：
  1. 如果使用 QQ 邮箱，需要在 QQ 邮箱设置中开启 SMTP 服务并获取授权码
  2. 如果使用 163 邮箱，server 改为 smtp.163.com
  3. 如果使用 Gmail，server 改为 smtp.gmail.com，port 改为 587
  4. password 是授权码，不是邮箱登录密码

  注意：请妥善保管此文件，不要泄露 password
  
  使用方法：
  1. 将此文件重命名为 emailconfig.xml（去掉 .example 后缀）
  2. 填写您的邮箱配置信息
-->
<emailconfig>
  <smtp 
    server="smtp.qq.com" 
    port="587" 
    user="your-email@qq.com" 
    password="" 
    from="your-email@qq.com" 
    fromname="信息科技学习平台" />
</emailconfig>
